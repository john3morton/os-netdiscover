      <nbns_enable type="BooleanField"><default>1</default><Required>Y</Required></nbns_enable>

      <tcp_probe_enable type="BooleanField"><default>0</default><Required>Y</Required></tcp_probe_enable>
      <tcp_probe_ports type="TextField"><default>22,80,443,445,3389,9100</default><Required>N</Required></tcp_probe_ports>
      <tcp_probe_timeout_ms type="IntegerField"><default>250</default><MinimumValue>50</MinimumValue><MaximumValue>3000</MaximumValue><Required>Y</Required></tcp_probe_timeout_ms>

      <snmp_enable type="BooleanField"><default>0</default><Required>Y</Required></snmp_enable>
      <snmp_communities type="TextField"><default>public</default><Required>N</Required></snmp_communities>
      <snmp_timeout_ms type="IntegerField"><default>400</default><MinimumValue>100</MinimumValue><MaximumValue>3000</MaximumValue><Required>Y</Required></snmp_timeout_ms>
      <snmp_rate_limit type="IntegerField"><default>3600</default><MinimumValue>60</MinimumValue><MaximumValue>86400</MaximumValue><Required>Y</Required></snmp_rate_limit>
